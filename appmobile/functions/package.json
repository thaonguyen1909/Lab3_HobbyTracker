{
  "name": "hobbytracker-moments-backend",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "start:api": "node --env-file=.env.local lib/server.js",
    "test:http": "node --test test/http.test.mjs test/cloudinary-media.test.mjs",
    "build": "tsc",
    "test": "node --test test/unit.test.mjs",
    "test:integration": "node --test --test-concurrency=1 test/integration.test.mjs test/delivery.test.mjs test/cleanup.test.mjs",
    "cleanup:local": "node scripts/cleanup-local.mjs",
    "test:cleanup-cli": "node --test test/cleanup-cli.test.mjs",
    "test:emulators": "npm --prefix ../firebase run test:all && npm run test:integration && npm run test:cleanup-cli"
  },
  "dependencies": {
    "cloudinary": "2.11.0",
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/node": "22.20.5",
    "firebase": "12.19.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  }
}
