
rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function canUploadMoment(uid, mid) {
   let upload = firestore.get(/databases/(default)/documents/users/$(uid)/momentUploads/$(mid)).data;
   return upload.authorId==uid && upload.status=='uploading' && upload.uploadDeadline>request.time
    && upload.stagingPath=='momentStaging/'+uid+'/'+mid+'/source';
  }
  match /momentStaging/{uid}/{mid}/source {
   allow create: if resource==null && request.auth!=null && request.auth.uid==uid && canUploadMoment(uid,mid)
    && request.resource.size>0 && request.resource.size<=5*1024*1024
    && request.resource.contentType in ['image/jpeg','image/png','image/webp'];
   allow read,update,delete: if false;
  }
  match /groupMoments/{gid}/{mid}/{generation}/{file} {
   // Serve bytes only through authenticated getGroupMomentImage. A direct Firebase
   // metadata GET may issue a reusable download token that outlives Firestore expiry.
   allow read,write: if false;
  }
  match /reports/{uid}/{file} {
   allow read,delete: if request.auth != null && request.auth.uid==uid;
   allow create,update: if request.auth != null && request.auth.uid==uid && file.matches('^[a-zA-Z0-9-]+[.]pdf$')
    && request.resource.size>0 && request.resource.size<=10*1024*1024 && request.resource.contentType=='application/pdf';
  }
  match /{allPaths=**} {allow read,write: if false;}
 }
}
