
rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() {return request.auth != null;}
  function owner(uid) {return signed() && request.auth.uid == uid;}
  function keys(d, fields) {return d.keys().hasAll(fields) && d.keys().hasOnly(fields);}
  function text(value, min, max) {return value is string && value.size() >= min && value.size() <= max;}
  function roleProfile(uid) {return /databases/$(database)/documents/users/$(uid);}
  function hobbyPath(uid,id) {return /databases/$(database)/documents/users/$(uid)/hobbies/$(id);}
  function activeHobby(uid,id) {return existsAfter(hobbyPath(uid,id)) && getAfter(hobbyPath(uid,id)).data.archived == false;}
  function member(gid) {return signed() && exists(/databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid));}
  function allowsDM(uid) {return exists(/databases/$(database)/documents/profiles/$(uid)) && get(/databases/$(database)/documents/profiles/$(uid)).data.allowMessages == true;}
  function chatMember(cid) {return signed() && request.auth.uid in get(/databases/$(database)/documents/directChats/$(cid)).data.participants;}
  function dmEnabled(cid) {let p=get(/databases/$(database)/documents/directChats/$(cid)).data.participants;return allowsDM(p[0]) && allowsDM(p[1]);}
  function validHobby(uid,hid,d) {
   return keys(d,['name','nameKey','description','icon','color','priority','archived','createdAt'])
    && text(d.name,2,50) && d.name.matches('^[^ ].*[^ ]$') && !d.name.matches('.*[/].*')
    && d.nameKey==d.name.lower() && text(d.description,0,180)
    && d.icon in ['spark','camera','music','book','palette','fitness','sports','code','garden','cook','chess','travel']
    && d.color in ['mint','blue','orange','purple','pink','gold'] && d.priority in ['active','interested']
    && d.archived is bool && d.createdAt is timestamp
    && (d.archived || getAfter(/databases/$(database)/documents/users/$(uid)/hobbyNames/$(d.nameKey)).data.hobbyId==hid);
  }
  function validPlan(uid,pid,d) {
   return keys(d,['hobbyId','title','startsAt','minutes','done','eventId','completionId'])
    && text(d.hobbyId,1,128) && activeHobby(uid,d.hobbyId) && text(d.title,1,70)
    && d.startsAt is timestamp && d.minutes is int && d.minutes>=1 && d.minutes<=1440 && d.done is bool
    && text(d.eventId,0,128) && text(d.completionId,0,128)
    && (d.eventId=='' || (pid=='event_'+d.eventId && exists(/databases/$(database)/documents/events/$(d.eventId))
      && getAfter(/databases/$(database)/documents/users/$(uid)/rsvps/$(d.eventId)).data.going==true))
    && ((!d.done && d.completionId=='') || (d.done && getAfter(/databases/$(database)/documents/users/$(uid)/history/$(d.completionId)).data.planId==pid));
  }
  function validPreferences(d) {
   return keys(d,['theme','displayName','handle','bio','color','music','search','reminders','leadMinutes','messages','groups','weekly','autoTimer','pauseOnExit','sound','visible','allowMessages'])
    && d.theme in ['Light','Dark','Energetic','Cyber','Art','Sad','Rainy Day']
    && text(d.displayName,2,80) && text(d.handle,0,24) && d.handle.matches('^[A-Za-z0-9_]*$') && text(d.bio,0,300)
    && d.color in ['mint','blue','orange','purple','pink','gold'] && d.music in ['youtube','spotify'] && d.search in ['google','coccoc']
    && d.reminders is bool && d.leadMinutes in [0,5,15,30,60] && d.messages is bool && d.groups is bool && d.weekly is bool
    && d.autoTimer is bool && d.pauseOnExit is bool && d.sound is bool && d.visible is bool && d.allowMessages is bool;
  }
  match /users/{uid} {
   allow get: if owner(uid);
   allow list,delete: if false;
   allow create: if owner(uid) && keys(request.resource.data,['role','displayName','createdAt'])
    && request.resource.data.role=='user' && text(request.resource.data.displayName,1,80) && request.resource.data.createdAt==request.time;
   allow update: if owner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
    && request.resource.data.role==resource.data.role && text(request.resource.data.displayName,1,80);
   match /hobbies/{hid} {
    allow read: if owner(uid);
    allow create: if owner(uid) && validHobby(uid,hid,request.resource.data) && request.resource.data.archived==false && request.resource.data.createdAt==request.time;
    allow update: if owner(uid) && resource.data.archived==false && validHobby(uid,hid,request.resource.data)
      && request.resource.data.createdAt==resource.data.createdAt
      && (!request.resource.data.archived || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archived']) && !existsAfter(/databases/$(database)/documents/users/$(uid)/hobbyNames/$(resource.data.nameKey))));
    allow delete: if false;
   }
   match /hobbyNames/{nameKey} {
    allow read: if owner(uid);
    allow create,update: if owner(uid) && keys(request.resource.data,['hobbyId'])
      && activeHobby(uid,request.resource.data.hobbyId) && getAfter(hobbyPath(uid,request.resource.data.hobbyId)).data.nameKey==nameKey
      && (!exists(/databases/$(database)/documents/users/$(uid)/hobbyNames/$(nameKey)) || resource.data.hobbyId==request.resource.data.hobbyId);
    allow delete: if owner(uid) && (!existsAfter(hobbyPath(uid,resource.data.hobbyId)) || getAfter(hobbyPath(uid,resource.data.hobbyId)).data.archived || getAfter(hobbyPath(uid,resource.data.hobbyId)).data.nameKey!=nameKey);
   }
   match /plans/{pid} {
    allow read,delete: if owner(uid);
    allow create: if owner(uid) && validPlan(uid,pid,request.resource.data) && request.resource.data.done==false;
    allow update: if owner(uid) && validPlan(uid,pid,request.resource.data)
      && (!resource.data.done || (request.resource.data.done && request.resource.data.completionId==resource.data.completionId));
   }
   match /history/{rid} {
    allow read: if owner(uid);
    allow create: if owner(uid) && keys(request.resource.data,['hobbyId','name','icon','color','elapsedMs','notes','finishedAt','planId'])
     && activeHobby(uid,request.resource.data.hobbyId) && request.resource.data.name==get(hobbyPath(uid,request.resource.data.hobbyId)).data.name
     && request.resource.data.icon==get(hobbyPath(uid,request.resource.data.hobbyId)).data.icon && request.resource.data.color==get(hobbyPath(uid,request.resource.data.hobbyId)).data.color
     && request.resource.data.elapsedMs is int && request.resource.data.elapsedMs>=0 && request.resource.data.elapsedMs<=86400000
     && text(request.resource.data.notes,0,2000) && request.resource.data.finishedAt==request.time && text(request.resource.data.planId,0,128)
     && (request.resource.data.planId=='' || (getAfter(/databases/$(database)/documents/users/$(uid)/plans/$(request.resource.data.planId)).data.completionId==rid && getAfter(/databases/$(database)/documents/users/$(uid)/plans/$(request.resource.data.planId)).data.done));
    allow update,delete: if false;
   }
   match /settings/{id} {
    allow read: if owner(uid);
    allow create,update: if owner(uid) && id=='preferences' && validPreferences(request.resource.data);
    allow create,update: if owner(uid) && id=='momentNotifications'
      && keys(request.resource.data,['enabled','previewOnLockScreen'])
      && request.resource.data.enabled is bool && request.resource.data.previewOnLockScreen is bool;
    allow delete: if false;
   }
   match /rsvps/{eid} {
    allow read: if owner(uid);
    allow create,update: if owner(uid) && keys(request.resource.data,['going']) && request.resource.data.going is bool && exists(/databases/$(database)/documents/events/$(eid));
    allow delete: if owner(uid);
   }
   match /groupLinks/{gid} {
    allow read: if owner(uid);
    allow create,update: if owner(uid) && keys(request.resource.data,['name']) && request.resource.data.name==getAfter(/databases/$(database)/documents/groups/$(gid)).data.name
     && existsAfter(/databases/$(database)/documents/groups/$(gid)/members/$(uid));
    allow delete: if false;
   }
   match /devices/{id} {
    allow read,delete: if owner(uid);
    allow create,update: if owner(uid) && keys(request.resource.data,['token','updatedAt']) && text(request.resource.data.token,1,4096) && request.resource.data.updatedAt==request.time;
   }
   match /momentUploads/{id} {
    allow read: if owner(uid);
    allow write: if false;
   }
   match /momentGroupSettings/{gid} {
    allow read: if owner(uid);
    allow create,update: if owner(uid) && member(gid) && keys(request.resource.data,['muted']) && request.resource.data.muted is bool;
    allow delete: if owner(uid);
   }
   match /momentInbox/{eventId} {
    allow read: if owner(uid);
    allow create: if false;
    allow update: if owner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
      && request.resource.data.read is bool;
    allow delete: if owner(uid);
   }
  }
  match /profiles/{uid} {
   allow get: if signed() && (owner(uid) || resource.data.visible==true);
   allow list: if signed() && resource.data.visible==true;
   allow create,update: if owner(uid) && keys(request.resource.data,['displayName','handle','bio','color','visible','allowMessages'])
    && text(request.resource.data.displayName,2,80) && text(request.resource.data.handle,0,24) && request.resource.data.handle.matches('^[A-Za-z0-9_]*$')
    && text(request.resource.data.bio,0,300) && request.resource.data.color in ['mint','blue','orange','purple','pink','gold']
    && request.resource.data.visible is bool && request.resource.data.allowMessages is bool;
   allow delete: if false;
  }
  match /posts/{pid} {
   allow read: if signed();
   allow create: if signed() && keys(request.resource.data,['authorId','authorName','text','topic','createdAt'])
    && request.resource.data.authorId==request.auth.uid && request.resource.data.authorName==get(roleProfile(request.auth.uid)).data.displayName
    && text(request.resource.data.text,3,800) && text(request.resource.data.topic,0,50) && request.resource.data.createdAt==request.time;
   allow update,delete: if false;
   match /likes/{uid} {
    allow read: if signed();
    allow create,update: if owner(uid) && exists(/databases/$(database)/documents/posts/$(pid)) && keys(request.resource.data,['uid','createdAt']) && request.resource.data.uid==uid && request.resource.data.createdAt==request.time;
    allow delete: if owner(uid);
   }
   match /comments/{cid} {
    allow read: if signed();
    allow create: if signed() && exists(/databases/$(database)/documents/posts/$(pid)) && keys(request.resource.data,['authorId','authorName','text','createdAt'])
     && request.resource.data.authorId==request.auth.uid && request.resource.data.authorName==get(roleProfile(request.auth.uid)).data.displayName && text(request.resource.data.text,1,300) && request.resource.data.createdAt==request.time;
    allow update,delete: if false;
   }
  }
  match /groups/{gid} {
   allow read: if signed();
   allow create: if signed() && keys(request.resource.data,['ownerId','name','topic','description','createdAt']) && request.resource.data.ownerId==request.auth.uid
    && text(request.resource.data.name,3,60) && text(request.resource.data.topic,0,50) && text(request.resource.data.description,0,300) && request.resource.data.createdAt==request.time
    && existsAfter(/databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid));
   allow update,delete: if false;
   match /moments/{mid} {
    allow get: if member(gid) && resource.data.status=='ready' && resource.data.expiresAt>request.time;
    // Lists are served by the authenticated backend; Rules are not query filters.
    allow list,write: if false;
   }
   match /members/{uid} {
    allow read: if owner(uid) || member(gid);
    allow create,update: if owner(uid) && keys(request.resource.data,['uid','joinedAt']) && request.resource.data.uid==uid && request.resource.data.joinedAt==request.time
     && existsAfter(/databases/$(database)/documents/groups/$(gid));
    allow delete: if false;
   }
  }
  match /groupChats/{gid}/messages/{mid} {
   allow read: if member(gid);
   allow create: if member(gid) && keys(request.resource.data,['senderId','text','createdAt']) && request.resource.data.senderId==request.auth.uid && text(request.resource.data.text,1,2000) && request.resource.data.createdAt==request.time;
   allow update,delete: if false;
  }
  match /events/{eid} {
   allow read: if signed();
   allow create: if signed() && keys(request.resource.data,['ownerId','title','topic','startsAt','createdAt']) && request.resource.data.ownerId==request.auth.uid && text(request.resource.data.title,3,120) && text(request.resource.data.topic,0,50)
    && request.resource.data.startsAt is timestamp && request.resource.data.startsAt>request.time && request.resource.data.createdAt==request.time;
   allow update,delete: if false;
  }
  match /directChats/{cid} {
   allow get: if signed() && (!exists(/databases/$(database)/documents/directChats/$(cid)) || request.auth.uid in resource.data.participants);
   allow list: if signed() && request.auth.uid in resource.data.participants;
   allow create: if signed() && keys(request.resource.data,['participants','createdAt']) && request.resource.data.participants is list && request.resource.data.participants.size()==2
    && request.resource.data.participants[0] is string && request.resource.data.participants[1] is string && request.resource.data.participants[0]!=request.resource.data.participants[1]
    && request.auth.uid in request.resource.data.participants && request.resource.data.createdAt==request.time && allowsDM(request.resource.data.participants[0]) && allowsDM(request.resource.data.participants[1]);
   allow update,delete: if false;
   match /messages/{mid} {
    allow read: if chatMember(cid);
    allow create: if chatMember(cid) && dmEnabled(cid) && keys(request.resource.data,['senderId','text','createdAt']) && request.resource.data.senderId==request.auth.uid && text(request.resource.data.text,1,2000) && request.resource.data.createdAt==request.time;
    allow update,delete: if false;
   }
  }
  match /{document=**} {allow read,write: if false;}
 }
}
